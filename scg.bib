	Selectif = {oui},
	Title = {Software Architecture Reconstruction: A Process-Oriented Taxonomy},
	Url = {http://scg.unibe.ch/archive/external/Duca09x-SOAArchitectureExtraction.pdf},
	Volume = {35},

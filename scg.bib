	Peerreview = {yes},
	Publisher = {IEEE Computer Society},
	Title = {Supporting Task-oriented Navigation in {IDEs} with Configurable {HeatMaps}},
	Url = {http://scg.unibe.ch/archive/papers/Roet09aHeatMapsICPC2009.pdf},
	Year = {2009},

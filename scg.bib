	Medium = {2},
	Peerreview = {yes},
	Title = {Towards a Moldable Debugger},
	Url = {http://scg.unibe.ch/archive/papers/Chis13a-TowardsMoldableDebugger.pdf},
	Year = {2013},
	isbn = {978-1-4503-2041-2},

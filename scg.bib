	Pages = {60--64},
	Publisher = {ACM Press},
	Title = {Design Guidelines for Tailorable Frameworks},
	Url = {http://scg.unibe.ch/archive/papers/Deme97bDesignGuidelines.pdf},
	Volume = {40},

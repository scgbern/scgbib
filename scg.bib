	Pages = {161--184},
	Publisher = {Springer-Verlag},
	Series = {LNCS},
	Title = {Typed Sets as a Basis for Object-Oriented Database Schemas},
	Url = {http://link.springer.de/link/service/series/0558/tocs/t0707.htm},
	Volume = {707},
	Year = {1993},
